{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://starnet.local/schemas/bamboo-asset-v1.json","title":"Bambú House Asset Record","type":"object","additionalProperties":false,
 "required":["schema_version","record_id","record_type","owner","jurisdiction","title","asset","ownership","valuation","documents","estate","provenance"],
 "properties":{
  "schema_version":{"const":"bamboo.asset/v1"},"record_id":{"type":"string","minLength":8,"maxLength":128},"record_type":{"enum":["real_property","business_interest","financial_account","vehicle","intellectual_property","personal_property","insurance","debt_or_obligation","digital_asset","other"]},
  "owner":{"type":"object","required":["owner_ref","capacity"],"properties":{"owner_ref":{"type":"string"},"capacity":{"enum":["individual","joint","entity","trust","estate","unknown"]}},"additionalProperties":false},
  "jurisdiction":{"type":"object","required":["country","region","locality","verification_status"],"properties":{"country":{"type":"string"},"region":{"type":["string","null"]},"locality":{"type":["string","null"]},"verification_status":{"enum":["unverified","source_verified","professional_verified"]}},"additionalProperties":false},
  "title":{"type":"string"},"asset":{"type":"object"},"ownership":{"type":"object","required":["status","percentage","acquired_at","source_refs"],"properties":{"status":{"enum":["claimed_unverified","documented","disputed","transferred","unknown"]},"percentage":{"type":["number","null"],"minimum":0,"maximum":100},"acquired_at":{"type":["string","null"]},"source_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true}},"additionalProperties":false},
  "valuation":{"type":"object","required":["amount_minor_units","currency","as_of","method","status"],"properties":{"amount_minor_units":{"type":["integer","null"],"minimum":0},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"as_of":{"type":["string","null"]},"method":{"type":["string","null"]},"status":{"enum":["unknown","owner_estimate","market_evidence","professional_appraisal"]}},"additionalProperties":false},
  "documents":{"type":"array","items":{"type":"object","required":["document_ref","kind","status"],"properties":{"document_ref":{"type":"string"},"kind":{"type":"string"},"status":{"enum":["missing","copy_unverified","source_verified","professional_verified"]}},"additionalProperties":false}},
  "estate":{"type":"object","required":["beneficiary_status","title_transfer_status","professional_review_status","notes"],"properties":{"beneficiary_status":{"enum":["unknown","not_designated","designated_unverified","documented"]},"title_transfer_status":{"enum":["unknown","not_reviewed","review_needed","documented"]},"professional_review_status":{"enum":["not_reviewed","legal_reviewed","tax_reviewed","both_reviewed"]},"notes":{"type":["string","null"]}},"additionalProperties":false},
  "risk_flags":{"type":"array","items":{"type":"string"},"uniqueItems":true},"provenance":{"type":"object","required":["created_at","created_by","source_refs"],"properties":{"created_at":{"type":"string","format":"date-time"},"created_by":{"const":"pi-personal-agent"},"source_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true}},"additionalProperties":false}
 }
}
