# PAULI STARNET — Sovereign Environment Configuration
# Generated: 2026-08-30 by Heisenberg Deployment
# Source: COSMOS.ENV (masked — values injected at runtime from keychain/env file)
#
# This file maps the COSMOS.ENV variables to STARNET's internal names.
# Values are NEVER committed — this file is gitignored.
# Populate from COSMOS.ENV at first-run setup.
#
# To apply:
#   $env = Get-Content C:\Users\execu\Downloads\COSMOS.ENV | ConvertFrom-StringData
#   (then copy relevant vars below, never commit the values)

# ─── MODEL PROVIDERS ──────────────────────────────────────────────────────────
# STARNET reads OPENAI_API_KEY directly (matches upstream env var name)
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Fallback / routing via LiteLLM proxy (covers Anthropic, Gemini, DeepSeek through proxy)
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=

# Direct providers (STARNET provider settings UI reads these)
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
VENICE_API_KEY=
OPEN_ROUTER_API=

# ─── STARNET RUNTIME ──────────────────────────────────────────────────────────
# Runtime identity — change only if running multiple STARNET instances
STARNET_OWNER_NAME=Pauli

# Concurrent agent limit (default: 4 — raise if server has headroom)
# STARNET_MAX_CONCURRENT_AGENTS=6

# Checkpoint rollback net — default ON; set to 0 to opt out
# STARNET_CHECKPOINTS=1

# ─── CHANNELS ─────────────────────────────────────────────────────────────────
# Telegram voice lane — loaded by Tauri keychain at app launch
# Set via STARNET settings UI → Channels → Telegram (preferred over raw env)
# Fall-through env injection for server/headless mode:
TELEGRAM_BOT_TOKEN=

# ─── COMMERCE / POD FACTORY ──────────────────────────────────────────────────
# Printify — read-only catalog initially, order scope requires explicit grant
PRINTIFY_KEY=

# Etsy — read-only catalog/search initially; draft/publish requires OAuth 2.0 browser flow
ETSY_API_KEY=

# Stripe — commerce payments (approval-gated, never autonomous spend)
STRIPE_SECRET_KEY=

# ─── INFRASTRUCTURE ───────────────────────────────────────────────────────────
# Tailscale — secure tunnel for remote observation
TAILSCALE_API_KEY=
TAILSCALE_NET_NAME=

# Cloudflare — DNS and tunnel management
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Coolify — server deployment
COOLIFY_URL=
COOLIFY_API_TOKEN=
COOLIFY_PROJECT_ID=

# ─── MEMORY / PERSISTENCE ─────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── CAPABILITIES (approval-gated — never autonomous) ─────────────────────────
# These are wired into STARNET MCP connectors but ALL require consent: true
FIRECRAWL_API_TOKEN=
ELEVEN_LABS_API=
VAPI_PRIVATE_KEY=
FAL_AI_API=
RESEND_API_TOKEN=

# ─── GITHUB (source control — workbench use only) ─────────────────────────────
GH_PAT=

# ─── SETUP COMPLETE MARKER ─────────────────────────────────────────────────────
# After filling all required vars above, set this to confirm wiring:
HEISENBERG_ENV_WIRED=false
