# one-system: the workforce gateway (gateway/workforce-server.js). Names only; values live on the server
# in /etc/starnet/workforce.env (mode 0600), never in git.

# Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000
GATEWAY_BEARER_TOKEN=            # owner/Instinct bearer; the Command Center's STARNET_FACTORY_TOKEN is this value
STARNET_PORT=8787                # the StarNet sidecar that executes agent runs
STARNET_SIDECAR_TOKEN=

# Paperclip (the only queue)
PAPERCLIP_URL=http://127.0.0.1:3100
PAPERCLIP_TOKEN=                 # board/service credential
PAPERCLIP_COMPANY_ID=            # one company for the operating organization; a second company (e.g. per agency) needs a second gateway with its own env
FACTORY_ROLES_FILE=/etc/starnet/factory-roles.json   # built from scripts/one-system/roles-template.mjs; see HANDOFF
FACTORY_WORKER_TOKEN=            # what Paperclip presents when it wakes a worker; not an owner credential
FACTORY_STATE_DIR=/var/lib/starnet/factory

# Rhythm (defaults shown)
FOREMAN_SWEEP_MS=300000          # Heisenberg's sweep: stalls, standing jobs, pipelines
CHIEF_STALE_MS=300000            # Instinct silent this long -> Heisenberg is acting chief
STALL_ACK_MS=7200000             # nudge after 2 hours idle
STALL_ESCALATE_MS=21600000       # escalate after 6 hours idle
STANDING_JOB_BUDGET_USD=0.25
# Standing jobs (scheduled missions from districts' CONTEXT.md). approved: only jobs the owner approved on the phone
# run, on their schedule, until stopped. off: none run (approvals are kept). Explicit missions and pipelines run either way.
STANDING_AUTOMATION=approved
# Minutes before an owner order the chief hasn't acknowledged shows as overdue (in milliseconds; default 15 minutes).
ORDER_ACK_MS=900000
# Second key for owner approvals (authorize, owner gates, standing-job approval). Give it to the Command Center only
# (STARNET_OWNER_APPROVAL_TOKEN there); never to Instinct or any agent.
OWNER_APPROVAL_TOKEN=
PIPELINE_STAGE_BUDGET_USD=1

# Models (registry/models.json is the source of truth for ids)
OPENROUTER_API_KEY=
# Free model pool (program/one-system/05_models/CONTEXT.md). Any of these turns free models on for tests and light work.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# When the factory runs apart from the sidecar, name the providers that have keys (names only, no keys):
FREE_POOL_PROVIDERS=
