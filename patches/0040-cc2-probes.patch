 fixtures/README.md                            |  15 +
 fixtures/factory-runners-RECORDED.json        |   4 +
 fixtures/factory-runs-RECORDED.json           | 701 ++++++++++++++++++
 fixtures/gateway-board-foreman-SYNTHETIC.json |   6 +
 fixtures/gateway-districts-SYNTHETIC.json     |   6 +
 probes-cc2.js                                 | 103 +++
 tests/cc2-probes.test.mjs                     |  79 ++
 7 files changed, 914 insertions(+)
