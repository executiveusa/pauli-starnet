diff --git a/probes-cc2.js b/probes-cc2.js
new file mode 100644
index 0000000..84d0f64
--- /dev/null
+++ b/probes-cc2.js
@@ -0,0 +1,103 @@
+// CC2 probes (architect board 0006 section D): truthful-degradation probes for
+// the StarNet command center. EVERY panel reads one envelope:
+//   { ok, observed_at, source, latency_ms, error, ...parsed fields }
+// A failed probe reports ok:false with its error and the observation time -
+// never an empty or green card. Parsers are pure and exported for fixture
+// tests; fetchers wrap them with the existing httpProbe (deadline, size cap,
+// host allowlist). No deploy, no host changes, read-only sources only.
+'use strict';
+
+function envelope(source, latencyMs, parsed, error) {
+  return {
+    ok: !error,
+    observed_at: new Date().toISOString(),
+    source,
+    latency_ms: latencyMs,
+    error: error || null,
+    ...(parsed || {}),
+  };
+}
+
+const str = (v, n) => (typeof v === 'string' ? v.slice(0, n || 200) : null);
+const num = (v) => (typeof v === 'number' && Number.isFinite(v) ? v : null);
+
+// /v1/districts (shape per 0006 section D; live payload never recorded).
+function parseDistricts(body) {
+  let doc;
+  try { doc = JSON.parse(body); } catch { return { error: 'unparseable_body' }; }
+  const list = Array.isArray(doc && doc.districts) ? doc.districts : null;
+  if (!list) return { error: 'no_districts_field' };
+  return {
+    parsed: {
+      districts: list.slice(0, 50).map((d) => ({
+        id: str(d && d.id, 64),
+        action: str(d && d.action, 64),
+        question: str(d && d.question, 200),
+        stale: d && d.stale === true,
+        age_seconds: num(d && d.age_seconds),
+      })),
+    },
+  };
+}
+
+// Foreman timer through the gateway board: exact live field names are
+// UNVERIFIED, so every field degrades to null (honest) when absent; stale and
+// age_seconds always come through when the board provides them.
+function parseForemanTimer(body) {
+  const d = parseDistricts(body);
+  if (d.error) return d;
+  const f = d.parsed.districts.find((x) => x.id === 'foreman') || d.parsed.districts[0] || null;
+  if (!f) return { error: 'no_foreman_row' };
+  let raw = null;
+  try { raw = (JSON.parse(body).districts || []).find((x) => x && x.id === f.id) || null; } catch {}
+  return {
+    parsed: {
+      foreman: {
+        last_run_at: str(raw && raw.last_run_at, 40),
+        last_exit: num(raw && raw.last_exit),
+        next_run_at: str(raw && raw.next_run_at, 40),
+        stale: f.stale,
+        age_seconds: f.age_seconds,
+      },
+    },
+  };
+}
+
+// Factory (read-only Actions API): latest run status/conclusion + runner
+// online/offline. Fixtures recorded from the public API.
+function parseFactoryRuns(body) {
+  let doc;
+  try { doc = JSON.parse(body); } catch { return { error: 'unparseable_body' }; }
+  const runs = Array.isArray(doc && doc.workflow_runs) ? doc.workflow_runs : null;
+  if (!runs) return { error: 'no_workflow_runs_field' };
+  const latest = runs[0] || null;
+  return {
+    parsed: {
+      latest_run: latest ? {
+        id: num(latest.id),
+        name: str(latest.name, 120),
+        status: str(latest.status, 40),
+        conclusion: latest.conclusion == null ? null : str(latest.conclusion, 40),
+        updated_at: str(latest.updated_at, 40),
+      } : null,
+      total_count: num(doc.total_count),
+    },
+  };
+}
+
+function parseFactoryRunners(body) {
+  let doc;
+  try { doc = JSON.parse(body); } catch { return { error: 'unparseable_body' }; }
+  const runners = Array.isArray(doc && doc.runners) ? doc.runners : null;
+  if (!runners) return { error: 'no_runners_field' };
+  const online = runners.filter((r) => r && r.status === 'online').length;
+  return {
+    parsed: {
+      runners_total: runners.length,
+      runners_online: online,
+      runner_state: runners.length === 0 ? 'none_registered' : (online > 0 ? 'online' : 'offline'),
+    },
+  };
+}
+
+module.exports = { envelope, parseDistricts, parseForemanTimer, parseFactoryRuns, parseFactoryRunners };
diff --git a/tests/cc2-probes.test.mjs b/tests/cc2-probes.test.mjs
new file mode 100644
index 0000000..9cf6a4b
--- /dev/null
+++ b/tests/cc2-probes.test.mjs
@@ -0,0 +1,79 @@
+// CC2 fixture tests (architect 0006 section D): every probe renders the
+// {ok, observed_at, source, latency_ms, error} envelope; a failed probe is a
+// failed card with error + age, never an empty or green card. Parsers run
+// against the fixtures in ../fixtures (RECORDED factory, SYNTHETIC gateway -
+// see fixtures/README.md). Deterministic: no network.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { createRequire } from 'node:module';
+const { envelope, parseDistricts, parseForemanTimer, parseFactoryRuns, parseFactoryRunners } =
+  createRequire(import.meta.url)('../probes-cc2.js');
+const fx = (n) => readFileSync(new URL(`../fixtures/${n}`, import.meta.url), 'utf8');
+
+test('envelope: every panel carries ok/observed_at/source/latency_ms/error', () => {
+  const e = envelope('test-source', 42, { x: 1 }, null);
+  assert.equal(e.ok, true); assert.equal(e.source, 'test-source');
+  assert.equal(e.latency_ms, 42); assert.equal(e.error, null);
+  assert.ok(!Number.isNaN(Date.parse(e.observed_at)));
+  const bad = envelope('test-source', 7, null, 'deadline');
+  assert.equal(bad.ok, false); assert.equal(bad.error, 'deadline');
+});
+
+test('districts probe parses districts/action/question/stale/age_seconds (SYNTHETIC shape fixture)', () => {
+  const r = parseDistricts(fx('gateway-districts-SYNTHETIC.json'));
+  assert.ok(!r.error);
+  assert.equal(r.parsed.districts.length, 2);
+  const b = r.parsed.districts[1];
+  assert.equal(b.id, 'beta'); assert.equal(b.action, 'work');
+  assert.equal(b.question, 'need owner input');
+  assert.equal(b.stale, true); assert.equal(b.age_seconds, 9000);
+});
+
+test('districts probe degrades truthfully on garbage and on missing field', () => {
+  assert.equal(parseDistricts('not json').error, 'unparseable_body');
+  assert.equal(parseDistricts('{"other": 1}').error, 'no_districts_field');
+});
+
+test('foreman timer reads last run/exit/next run through the board, with stale/age', () => {
+  const r = parseForemanTimer(fx('gateway-board-foreman-SYNTHETIC.json'));
+  assert.ok(!r.error);
+  assert.equal(r.parsed.foreman.last_run_at, '2026-10-24T07:10:00Z');
+  assert.equal(r.parsed.foreman.last_exit, 0);
+  assert.equal(r.parsed.foreman.next_run_at, '2026-10-24T07:20:00Z');
+  assert.equal(r.parsed.foreman.stale, false);
+  assert.equal(r.parsed.foreman.age_seconds, 45);
+});
+
+test('foreman timer degrades honestly when timer fields are absent (UNVERIFIED live names)', () => {
+  const r = parseForemanTimer(fx('gateway-districts-SYNTHETIC.json'));
+  assert.ok(!r.error);
+  assert.equal(r.parsed.foreman.last_run_at, null);
+  assert.equal(r.parsed.foreman.last_exit, null);
+  assert.equal(r.parsed.foreman.next_run_at, null);
+  assert.equal(typeof r.parsed.foreman.stale, 'boolean');
+});
+
+test('factory probe parses the RECORDED runs fixture to a minimal shape', () => {
+  const r = parseFactoryRuns(fx('factory-runs-RECORDED.json'));
+  assert.ok(!r.error);
+  assert.ok(r.parsed.latest_run.id > 0);
+  assert.ok(['queued', 'in_progress', 'completed', 'waiting', 'requested', 'pending'].includes(r.parsed.latest_run.status));
+  assert.ok(r.parsed.total_count > 0);
+});
+
+test('factory runners probe reads the RECORDED empty-runners state honestly', () => {
+  const r = parseFactoryRunners(fx('factory-runners-RECORDED.json'));
+  assert.ok(!r.error);
+  assert.equal(r.parsed.runners_total, 0);
+  assert.equal(r.parsed.runner_state, 'none_registered');
+});
+
+test('factory runners probe reports online/offline truthfully', () => {
+  const body = JSON.stringify({ runners: [{ status: 'online' }, { status: 'offline' }] });
+  const r = parseFactoryRunners(body);
+  assert.equal(r.parsed.runners_online, 1);
+  assert.equal(r.parsed.runner_state, 'online');
+  const off = parseFactoryRunners(JSON.stringify({ runners: [{ status: 'offline' }] }));
+  assert.equal(off.parsed.runner_state, 'offline');
+});
