From d0338d6e2ac64f559771668a4f94111eeb1fdfdc Mon Sep 17 00:00:00 2001
From: "Instinct Builder (for Bambu)" <builder@localhost>
Date: Sat, 24 Oct 2026 03:38:25 -0600
Subject: [PATCH] CC3b: least-privilege auth - classify token then per-route
 scope (pairing off /api/canonical -> 403; invalid/missing -> 401), GET-only
 method guards after auth (405 Allow: GET); 12-test live-server auth matrix;
 suite 24/24

---
 mission-control-api.js   | 39 ++++++++++++++--
 tests/cc3b-auth.test.mjs | 99 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 134 insertions(+), 4 deletions(-)
 create mode 100644 tests/cc3b-auth.test.mjs

diff --git a/mission-control-api.js b/mission-control-api.js
index 5dd4fd9..6686b6a 100644
--- a/mission-control-api.js
+++ b/mission-control-api.js
@@ -122,14 +122,36 @@ function tokenEq(a, b) {
   return crypto.timingSafeEqual(ha, hb);
 }
 
-function checkAuth(req, res, query, allowCity, allowCanonicalToken) {
+// CC3b (least privilege): classify the bearer token first, then authorize per
+// route. Unknown or missing token -> 401 (caller learns nothing). Valid token
+// without scope for the route -> 403. The pairing (city-session) token is NOT
+// admitted to /api/canonical: the canonical token already serves that consumer.
+function classifyToken(req) {
   const auth = req.headers.authorization || '';
   const token = auth.replace('Bearer ', ''); // tokens in ?key= URL params are no longer accepted (access logs / history leak)
-  const ok = tokenEq(token, ADMIN_TOKEN) || (allowCity && citySessionValid(token)) || (allowCanonicalToken && tokenEq(token, CANONICAL_TOKEN));
-  if (!ok) {
+  if (!token) return 'none';
+  if (tokenEq(token, ADMIN_TOKEN)) return 'admin';
+  if (citySessionValid(token)) return 'city';
+  if (CANONICAL_TOKEN && tokenEq(token, CANONICAL_TOKEN)) return 'canonical';
+  return 'none'; // invalid token is indistinguishable from no token
+}
+
+const ROUTE_SCOPES = {
+  '/api/city': ['admin', 'city'],
+  '/api/canonical': ['admin', 'canonical'],
+};
+
+function checkAuth(req, res, path_) {
+  const kind = classifyToken(req);
+  if (kind === 'none') {
     json(res, 401, { error: 'Unauthorized' });
     return false;
   }
+  const scopes = ROUTE_SCOPES[path_] || ['admin'];
+  if (!scopes.includes(kind)) {
+    json(res, 403, { error: 'Forbidden' });
+    return false;
+  }
   return true;
 }
 
@@ -594,7 +616,16 @@ const server = http.createServer(async (req, res) => {
     return;
   }
 
-  if (!checkAuth(req, res, query, path_ === '/api/city' || path_ === '/api/canonical', path_ === '/api/canonical')) return;
+  if (!checkAuth(req, res, path_)) return;
+
+  // CC3b: /api/city and /api/canonical are read-only getters - GET only. The
+  // method guard sits AFTER auth so an unauthenticated caller still gets 401
+  // and learns nothing about the route.
+  if ((path_ === '/api/city' || path_ === '/api/canonical') && req.method !== 'GET') {
+    res.setHeader('Allow', 'GET');
+    json(res, 405, { error: 'Method not allowed' });
+    return;
+  }
 
   try {
     if (path_ === '/api/state' || path_ === '/api/dashboard') {
diff --git a/tests/cc3b-auth.test.mjs b/tests/cc3b-auth.test.mjs
new file mode 100644
index 0000000..b1bcb8e
--- /dev/null
+++ b/tests/cc3b-auth.test.mjs
@@ -0,0 +1,99 @@
+// CC3b auth matrix (architect 0049): pairing token off /api/canonical, GET-only
+// method guards AFTER auth, 401 for no/invalid token, 403 for valid-but-wrong-scope.
+// Spawns the real server with test env tokens and a seeded pairing session.
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { writeFileSync, rmSync } from 'node:fs';
+import crypto from 'node:crypto';
+
+const PORT = 8017;
+const BASE = `http://127.0.0.1:${PORT}`;
+const ADMIN = 'test-admin-token-cc3b';
+const CANONICAL = 'test-canonical-token-cc3b';
+const CITY = 'test-city-token-cc3b';
+const SESS = `/tmp/cc3b-sessions-${process.pid}.json`;
+let child;
+
+const call = (path_, method, token) =>
+  fetch(BASE + path_, { method, headers: token ? { Authorization: 'Bearer ' + token } : {} });
+
+before(async () => {
+  const h = crypto.createHash('sha256').update(CITY).digest('hex');
+  writeFileSync(SESS, JSON.stringify({ codes: {}, sessions: { [h]: { created: Date.now(), exp: Date.now() + 3600e3 } } }), { mode: 0o600 });
+  child = spawn(process.execPath, ['mission-control-api.js'], {
+    env: { ...process.env, ADMIN_TOKEN: ADMIN, CANONICAL_TOKEN: CANONICAL, PAULI_MC_SESSIONS_FILE: SESS },
+    stdio: 'ignore',
+  });
+  for (let i = 0; i < 50; i++) {
+    try { const r = await fetch(BASE + '/api/health'); if (r.ok) return; } catch {}
+    await new Promise((r) => setTimeout(r, 200));
+  }
+  throw new Error('server did not start');
+});
+
+after(() => { if (child) child.kill('SIGKILL'); rmSync(SESS, { force: true }); });
+
+test('pairing token -> GET /api/city 200', async () => {
+  const r = await call('/api/city', 'GET', CITY);
+  assert.equal(r.status, 200);
+  const d = await r.json();
+  assert.ok(d && typeof d === 'object' && 'system' in d);
+});
+
+test('pairing token -> GET /api/canonical 403 (CC3b A1: canonical token serves that consumer)', async () => {
+  const r = await call('/api/canonical', 'GET', CITY);
+  assert.equal(r.status, 403);
+});
+
+test('canonical token -> GET /api/canonical 200 (unchanged)', async () => {
+  const r = await call('/api/canonical', 'GET', CANONICAL);
+  assert.equal(r.status, 200);
+});
+
+test('canonical token -> GET /api/city 403 (read-only canonical scope, unchanged restriction)', async () => {
+  const r = await call('/api/city', 'GET', CANONICAL);
+  assert.equal(r.status, 403);
+});
+
+test('pairing token -> POST /api/city 405 with Allow: GET (CC3b A2)', async () => {
+  const r = await call('/api/city', 'POST', CITY);
+  assert.equal(r.status, 405);
+  assert.equal(r.headers.get('allow'), 'GET');
+});
+
+test('pairing token -> POST /api/canonical 405 would be 403 first (scope before method)', async () => {
+  const r = await call('/api/canonical', 'POST', CITY);
+  assert.equal(r.status, 403);
+});
+
+test('admin -> POST /api/city 405 with Allow: GET (method guard binds admin too)', async () => {
+  const r = await call('/api/city', 'POST', ADMIN);
+  assert.equal(r.status, 405);
+  assert.equal(r.headers.get('allow'), 'GET');
+});
+
+test('no token -> POST /api/city 401 (auth before method: learns nothing)', async () => {
+  const r = await call('/api/city', 'POST', null);
+  assert.equal(r.status, 401);
+});
+
+test('no token -> GET /api/city 401', async () => {
+  const r = await call('/api/city', 'GET', null);
+  assert.equal(r.status, 401);
+});
+
+test('invalid token -> 401 (indistinguishable from no token)', async () => {
+  const r = await call('/api/city', 'GET', 'not-a-real-token');
+  assert.equal(r.status, 401);
+});
+
+test('admin unchanged: GET /api/city and GET /api/canonical 200', async () => {
+  assert.equal((await call('/api/city', 'GET', ADMIN)).status, 200);
+  assert.equal((await call('/api/canonical', 'GET', ADMIN)).status, 200);
+});
+
+test('admin unchanged: GET /api/agents 200; pairing token there 403', async () => {
+  assert.equal((await call('/api/agents', 'GET', ADMIN)).status, 200);
+  assert.equal((await call('/api/agents', 'GET', CITY)).status, 403);
+});
