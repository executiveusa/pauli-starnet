From 3d48be70d0cbb3b489e206675ef91a65f8ed7b01 Mon Sep 17 00:00:00 2001
From: "Claude (architect)" <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 19:31:54 +0000
Subject: [PATCH] fix(build): pin Prisma 6.x; block unmigrated Prisma major
 bumps

Dependabot group bump #43 (2026-09-24) moved prisma and @prisma/client
from ^6.16 to ^7.10 without the Prisma 7 migration. Prisma 7 rejects the
datasource url in schema.prisma (P1012), so the client is never generated
and tsc reports 25 errors (missing exports, implicit any, removed
runtime/library path). Pinning ^6.16 restores generate, tsc 0 errors,
jest 53/53 and next build. Dependabot now skips Prisma majors.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/dependabot.yml |   8 +
 package.json           |   4 +-
 yarn.lock              | 907 +++++++----------------------------------
 3 files changed, 164 insertions(+), 755 deletions(-)

diff --git a/.github/dependabot.yml b/.github/dependabot.yml
index d2c37b6..f273492 100644
--- a/.github/dependabot.yml
+++ b/.github/dependabot.yml
@@ -23,6 +23,14 @@ updates:
     schedule:
       interval: "weekly"
     open-pull-requests-limit: 1
+    # Prisma majors need a schema/client migration (7.x moved the datasource
+    # URL to prisma.config.ts and requires a driver adapter); the grouped bump
+    # in #43 broke the build. Upgrade Prisma majors deliberately, not here.
+    ignore:
+      - dependency-name: "prisma"
+        update-types: ["version-update:semver-major"]
+      - dependency-name: "@prisma/client"
+        update-types: ["version-update:semver-major"]
     groups:
       all-dependencies:
         patterns:
